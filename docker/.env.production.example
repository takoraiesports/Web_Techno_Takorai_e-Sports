# Copy to docker/.env.production on the server and replace every secret value.
# Point both DOMAIN and api.DOMAIN DNS records to this server's public IP.
DOMAIN=club.example.edu
# Exact production frontend origins allowed to call the API (comma-separated).
FRONTEND_URLS=https://ttes-club.vercel.app

POSTGRES_DB=esports_db
POSTGRES_USER=esports_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_REDIS_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

MINIO_ROOT_USER=esports_storage
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_STORAGE_PASSWORD
S3_BUCKET_NAME=esports-assets
S3_REGION=us-east-1

JWT_EXPIRATION_HOURS=12

# Required the first time the database has no administrator.
# After the first successful deployment, remove INITIAL_ADMIN_PASSWORD.
INITIAL_ADMIN_EMAIL=club-admin@example.edu
INITIAL_ADMIN_USERNAME=club-admin
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS
