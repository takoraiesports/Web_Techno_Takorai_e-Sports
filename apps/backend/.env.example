PORT=8080
ENV=development
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=esports_user
DB_PASSWORD=esports_dev_password_change_in_prod
DB_NAME=esports_db
DB_SSLMODE=disable

# Redis Cache & PubSub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=esports_redis_dev_password
REDIS_DB=0

# JWT Auth
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRATION_HOURS=24

# S3 Object Storage (MinIO or AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=esports-assets
S3_USE_PATH_STYLE=true
